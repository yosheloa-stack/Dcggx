# ==============================================================
#  GGX BOT — Variáveis de ambiente
#  Copie este arquivo para ".env" e preencha com seus dados.
# ==============================================================

# Token do bot (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=coloque_o_token_aqui

# ID da aplicação (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=coloque_o_client_id_aqui

# (Opcional) ID de um servidor para registrar comandos instantaneamente durante testes.
# Deixe em branco para registrar globalmente (pode demorar até 1h para aparecer).
GUILD_ID=

# ID do dono do bot (seu ID de usuário do Discord).
# Comandos como /setup e /config só funcionam para o dono e para quem tiver o cargo GGX Admin.
OWNER_ID=coloque_seu_id_aqui

# ==============================================================
#  Anti-NSFW avançado (OPCIONAL)
#  Detecção REAL de conteúdo em imagens/vídeos/figurinhas.
#  Sem isso, o bot usa apenas o filtro heurístico (texto, links,
#  nomes de figurinha e bloqueio de mídia em canais não-NSFW).
#
#  Provedor suportado: Sightengine (https://sightengine.com)
# ==============================================================
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# ==============================================================
#  Comando /like — Envio de likes no Free Fire (Frifas Likes API)
#  Repositório de referência:
#  https://github.com/HubsGGx/Daily-Likes-FreeFire
# ==============================================================
FRIFAS_API_KEY=coloque_sua_chave_aqui
# (Opcional) trocar a URL base da API, se necessário:
# FRIFAS_BASE_URL=https://fluxdevservice.com/api/frifas
